diff --git a/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/a11y/ChatSendEvidence.kt b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/a11y/ChatSendEvidence.kt
new file mode 100644
index 0000000000000000000000000000000000000000..4a98945d232572d9683af23490626b906cc89edc
--- /dev/null
+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/a11y/ChatSendEvidence.kt
@@ -0,0 +1,83 @@
+// SPDX-FileCopyrightText: 2026 zhehong268
+// SPDX-License-Identifier: AGPL-3.0-only
+package io.github.ccch1mneyyy.dsh_app.phone.a11y
+
+import java.security.MessageDigest
+
+/** Adapted from dsh Android's MessageEffect (zhehong268, AGPL-3.0). */
+internal class ChatSendEvidence private constructor(
+    private val packageName: String,
+    private val windowId: Int,
+    private val title: String,
+    private val body: String,
+    private val existing: Int,
+) {
+    fun verified(windows: List<UiWindow>): Boolean {
+        val window = windows.singleOrNull { it.id == windowId && it.packageName == packageName } ?: return false
+        val nodes = window.root?.let(::flatten)?.toList() ?: return false
+        if (title != chatTitle(window.bounds, nodes)) return false
+        if (nodes.any { it.visibleLabel() in failedOrPending }) return false
+        val editors = nodes.filter { it.editable && !it.password && !it.bounds.isEmpty && !it.isSearch() }
+        if (editors.size > 1 || editors.any { !it.showingHint && !it.text.isNullOrBlank() }) return false
+        return matchingOutgoing(nodes, window.bounds, body) > existing
+    }
+
+    companion object {
+        const val WECHAT = "com.tencent.mm"
+        private val supported = setOf(WECHAT, "com.tencent.mobileqq", "com.tencent.tim")
+        private val sendLabels = setOf("发送", "发送消息", "send", "send message")
+        private val failedOrPending = setOf("发送失败", "未发送", "重新发送", "发送中", "正在发送", "sending", "failed to send")
+        private val search = Regex("搜索|查找|search", RegexOption.IGNORE_CASE)
+        private val ownPrefix = Regex("^(?:我|本人|我发送的消息|你发送了|You sent)[：:,，]\\s*", RegexOption.IGNORE_CASE)
+
+        fun isSend(pkg: String?, label: String, viewId: String?) =
+            pkg in supported && (label.trim().lowercase() in sendLabels ||
+                viewId?.substringAfterLast('/')?.lowercase() in setOf("btn_send", "btn_sendmsg", "send_btn"))
+
+        fun before(windows: List<UiWindow>, packageName: String, button: Box): ChatSendEvidence? {
+            val window = windows.singleOrNull { it.packageName == packageName && it.bounds.intersect(button) == button }
+                ?: return null
+            val nodes = window.root?.let(::flatten)?.toList() ?: return null
+            val editors = nodes.filter {
+                it.editable && !it.password && !it.showingHint && !it.isSearch() &&
+                    !it.text.isNullOrBlank() && it.bounds.rowOverlap(button) >= 0.5
+            }
+            val sender = editors.singleOrNull() ?: return null
+            val body = digest(sender.text ?: return null)
+            val title = chatTitle(window.bounds, nodes) ?: return null
+            return ChatSendEvidence(packageName, window.id, title, body, matchingOutgoing(nodes, window.bounds, body))
+        }
+
+        private fun flatten(node: UiNode): Sequence<UiNode> =
+            sequenceOf(node) + node.children.asSequence().flatMap(::flatten)
+
+        private fun UiNode.isSearch() = listOfNotNull(viewId, hint, desc).any(search::containsMatchIn)
+
+        private fun UiNode.visibleLabel() = (text ?: desc).orEmpty().trim().lowercase()
+
+        private fun chatTitle(bounds: Box, nodes: List<UiNode>): String? {
+            val candidates = nodes.filter {
+                !it.editable && !it.password && it.children.isEmpty() && !it.text.isNullOrBlank() &&
+                    it.bounds.top >= bounds.top && it.bounds.bottom < bounds.top + bounds.height / 6
+            }
+            val first = candidates.minOfOrNull { it.bounds.top } ?: return null
+            return candidates.filter { it.bounds.top == first }.mapNotNull { it.text }.distinct().singleOrNull()?.let(::digest)
+        }
+
+        private fun matchingOutgoing(nodes: List<UiNode>, bounds: Box, body: String): Int = nodes.asSequence()
+            .filter { !it.editable && !it.password && it.children.isEmpty() && !it.bounds.isEmpty }
+            .filter { it.bounds.top >= bounds.top + bounds.height / 6 }
+            .filter { node ->
+                val description = node.desc.orEmpty()
+                val own = ownPrefix.find(description)
+                (own != null && digest(description.substring(own.range.last + 1)) == body) ||
+                    (node.bounds.left >= bounds.centerX && node.text?.let(::digest) == body)
+            }
+            .map { it.bounds }.distinct().count()
+
+        private fun digest(text: String): String =
+            MessageDigest.getInstance("SHA-256")
+                .digest(text.replace("\r\n", "\n").replace('\r', '\n').toByteArray(Charsets.UTF_8))
+                .joinToString("") { "%02x".format(it.toInt() and 255) }
+    }
+}

+++ b/app/android/app/src/main/kotlin/io/github/ccch1mneyyy/dsh_app/phone/a11y/VisualEnvironment.kt
@@ -0,0 +1,78 @@
+// SPDX-FileCopyrightText: 2026 zhehong268
+// SPDX-License-Identifier: AGPL-3.0-only
+package io.github.ccch1mneyyy.dsh_app.phone.a11y
+
+import android.app.WallpaperManager
+import android.content.Context
+import android.graphics.Bitmap
+import android.os.Build
+import android.os.SystemClock
+import java.util.Locale
+
+/** Adapts the dsh Android wallpaper and on-screen palette summaries. */
+internal class VisualEnvironment(private val context: Context) {
+    private var wallpaperAt = -1L
+    private var wallpaperColors = ""
+
+    fun describe(windows: List<UiWindow>): String {
+        val now = SystemClock.uptimeMillis()
+        if (wallpaperAt < 0 || now - wallpaperAt > 60_000) {
+            wallpaperColors = "桌面壁纸主色：${wallpaper(WallpaperManager.FLAG_SYSTEM)}，锁屏壁纸主色：${wallpaper(WallpaperManager.FLAG_LOCK)}。"
+            wallpaperAt = now
+        }
+        val families = windows.asSequence().mapNotNull { it.root }
+            .flatMap(::nodes).flatMap { it.fontFamilies.asSequence() }.distinct().take(5).toList()
+        val fontScale = context.resources.configuration.fontScale
+        val fontDescription = families.joinToString().ifEmpty { "未上报" }
+        return "字号缩放：$fontScale，控件公开字族：$fontDescription。$wallpaperColors"
+    }
+
+    private fun wallpaper(which: Int): String {
+        if (Build.VERSION.SDK_INT < 27) return "系统未提供"
+        return try {
+            val colors = WallpaperManager.getInstance(context).getWallpaperColors(which)
+            listOfNotNull(colors?.primaryColor, colors?.secondaryColor, colors?.tertiaryColor)
+                .joinToString { hex(it.toArgb()) }.ifEmpty { "系统未提供" }
+        } catch (_: RuntimeException) {
+            "系统未提供"
+        }
+    }
+
+    companion object {
+        private fun nodes(node: UiNode): Sequence<UiNode> =
+            sequenceOf(node) + node.children.asSequence().flatMap(::nodes)
+
+        fun foregroundExclusions(window: UiWindow): List<Box> = window.root?.let(::nodes).orEmpty()
+            .filter { it.password || it.editable || (it.children.isEmpty() && (!it.text.isNullOrBlank() || !it.desc.isNullOrBlank())) }
+            .map { it.bounds }.toList()
+
+        fun palette(bitmap: Bitmap, origin: Box, regions: List<Box>, excluded: List<Box> = emptyList()): String? {
+            val counts = mutableMapOf<Int, Int>()
+            var samples = 0
+            var bright = 0
+            val stride = maxOf(12, minOf(bitmap.width, bitmap.height) / 30)
+            for (y in stride / 2 until bitmap.height step stride) {
+                val screenY = origin.top + y * origin.height / bitmap.height
+                for (x in stride / 2 until bitmap.width step stride) {
+                    val screenX = origin.left + x * origin.width / bitmap.width
+                    if (regions.none { it.contains(screenX, screenY) } ||
+                        excluded.any { it.contains(screenX, screenY) }) continue
+                    val pixel = bitmap.getPixel(x, y)
+                    val red = pixel ushr 16 and 255
+                    val green = pixel ushr 8 and 255
+                    val blue = pixel and 255
+                    if (red * 2126 + green * 7152 + blue * 722 >= 1_280_000) bright++
+                    val rgb = pixel and 0x00E0E0E0
+                    counts[rgb] = counts.getOrDefault(rgb, 0) + 1
+                    samples++
+                }
+            }
+            if (samples < 8) return null
+            val colors = counts.entries.sortedWith(compareByDescending<Map.Entry<Int, Int>> { it.value }.thenBy { it.key })
+            val lightness = if (bright * 2 >= samples) "偏亮" else "偏暗"
+            return "$lightness，主色 ${colors.take(3).joinToString { hex(it.key) }}"
+        }
+
+        private fun hex(rgb: Int): String = String.format(Locale.ROOT, "#%06X", rgb and 0xFFFFFF)
+    }
+}

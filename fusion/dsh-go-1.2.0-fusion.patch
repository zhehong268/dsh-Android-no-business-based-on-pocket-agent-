diff --git a/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/phone/a11y/ChatSendEvidenceTest.kt b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/phone/a11y/ChatSendEvidenceTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..7817b2fdedb0403cf68c6fba99a3994d9d1c99c9
--- /dev/null
+++ b/app/android/app/src/test/kotlin/io/github/ccch1mneyyy/dsh_app/phone/a11y/ChatSendEvidenceTest.kt
@@ -0,0 +1,33 @@
+package io.github.ccch1mneyyy.dsh_app.phone.a11y
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class ChatSendEvidenceTest {
+    private val screen = Box(0, 0, 1000, 2000)
+    private val composer = Box(40, 1740, 840, 1860)
+    private val send = Box(850, 1750, 975, 1840)
+    private val text = "收到，明天见"
+
+    private fun bubble(left: Int, top: Int) =
+        UiNode(text = text, bounds = Box(left, top, left + 250, top + 56))
+
+    private fun windows(draft: String, bubbles: List<UiNode>, title: String = "测试联系人") =
+        listOf(UiWindow(4, WindowKind.APP, ChatSendEvidence.WECHAT, null, screen,
+            UiNode(bounds = screen, children = listOf(
+                UiNode(text = title, bounds = Box(220, 80, 710, 125)),
+                UiNode(text = draft, editable = true, bounds = composer),
+            ) + bubbles)))
+
+    @Test fun detectsNewOwnBubbleAndClearedComposer() {
+        val oldBubble = bubble(610, 700)
+        val before = checkNotNull(ChatSendEvidence.before(windows(text, listOf(oldBubble)), ChatSendEvidence.WECHAT, send))
+        val newBubble = bubble(630, 820)
+        assertTrue(before.verified(windows("", listOf(oldBubble, newBubble))))
+        assertFalse(before.verified(windows("", listOf(oldBubble))))
+        assertFalse(before.verified(windows(text, listOf(oldBubble, newBubble))))
+        assertFalse(before.verified(windows("", listOf(oldBubble, bubble(60, 820)))))
+        assertFalse(before.verified(windows("", listOf(oldBubble, newBubble), title = "另一个联系人")))
+    }
+}
